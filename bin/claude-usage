#!/usr/bin/env bash
# Emit usage facts about this Claude setup, from the session transcripts.
#
# Two things that will mislead you if you forget them:
#
# 1. Transcripts are a ROLLING ~30-DAY WINDOW (no cleanupPeriodDays set, so the harness
#    default applies). Anything older is already deleted, so "0 uses" means "not in the
#    window", never "never used". Every consumer must state the window.
# 2. A transcript's PROJECT DIRECTORY is fixed at session launch, but agent discovery
#    follows `cwd`, which changes within a session. So attribute work by each entry's
#    `.cwd` field, never by which project dir the file sits in.
#
# Read-only. Emits facts for a human or model to interpret; it draws no conclusions.
set -uo pipefail

PROJECTS="$HOME/.claude/projects"
REPOS="$HOME/.claude/repos"
CODE_DIR="${CODE_DIR:-$HOME/Documents}"

[ -d "$PROJECTS" ] || { echo "no transcripts at $PROJECTS" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq required" >&2; exit 1; }

# maxdepth 2: session transcripts live directly under each project dir. Deeper files are
# sidechains that carry no Task calls, so including them only risks double counting.
transcripts() { find "$PROJECTS" -maxdepth 2 -name '*.jsonl' -type f -print0; }
short() { sed "s|$CODE_DIR/||"; }

echo "=== WINDOW ==="
printf 'transcripts: %s\n' "$(transcripts | xargs -0 -n1 basename 2>/dev/null | grep -c . || echo 0)"
dates=$(transcripts | xargs -0 stat -f '%Sm' -t '%Y-%m-%d' 2>/dev/null | sort)
printf 'oldest: %s\nnewest: %s\n' "$(echo "$dates" | head -1)" "$(echo "$dates" | tail -1)"
echo "NOTE: rolling window. 0 uses means 'unused in this window', not 'never used'."

# agent <TAB> repo, one line per delegation
delegations=$(transcripts | xargs -0 cat 2>/dev/null \
  | jq -rc 'select(.type=="assistant") | (.cwd // "unknown") as $c | .message.content[]?
            | select(.type=="tool_use" and (.name=="Task" or .name=="Agent"))
            | "\(.input.subagent_type // "unspecified")\t\($c)"' 2>/dev/null \
  | short | sed 's|\(\t[^/]*\)/.*|\1|')

commands=$(transcripts | xargs -0 grep -ho '<command-name>/[a-z0-9:-]*' 2>/dev/null \
  | sed 's|.*<command-name>/||' | grep -v '^$' | sort)

echo
echo "=== DELEGATIONS by agent and cwd ==="
if [ -n "$delegations" ]; then
  echo "$delegations" | sort | uniq -c | sort -rn | sed 's/\t/  in  /'
  printf 'total: %s\n' "$(echo "$delegations" | grep -c .)"
else
  echo "(none)"
fi

echo
echo "=== SLASH COMMANDS typed ==="
[ -n "$commands" ] && echo "$commands" | uniq -c | sort -rn || echo "(none)"

echo
echo "=== DECLARED AGENTS vs USAGE ==="
echo "'scoped' = uses from a cwd inside that agent's own repo; a repo-scoped agent is"
echo "only reachable there. 'total' counts every cwd, to show where the work really happened."
printf '%-24s %-22s %8s %8s\n' AGENT SCOPE scoped total
{
  for f in "$HOME"/.claude/agents/*.md; do
    [ -e "$f" ] && printf '%s\tuser\n' "$(basename "$f" .md)"
  done
  for d in "$REPOS"/*/agents; do
    [ -d "$d" ] || continue
    repo=$(basename "$(dirname "$d")")
    for f in "$d"/*.md; do
      [ -e "$f" ] && printf '%s\t%s\n' "$(basename "$f" .md)" "$repo"
    done
  done
} | sort | while IFS=$'\t' read -r name scope; do
  total=$(echo "$delegations" | cut -f1 | grep -cx "$name" || true)
  if [ "$scope" = user ]; then
    scoped="$total"
  else
    scoped=$(echo "$delegations" | grep -cx "$name	$scope" || true)
  fi
  printf '%-24s %-22s %8s %8s\n' "$name" "$scope" "$scoped" "$total"
done

echo
echo "=== DECLARED COMMANDS vs USAGE ==="
{
  for f in "$HOME"/.claude/commands/*.md; do
    [ -e "$f" ] && printf '%s\tuser\n' "$(basename "$f" .md)"
  done
  for d in "$CODE_DIR"/*/.claude/commands; do
    [ -d "$d" ] || continue
    printf '%s\t%s\n' "$(basename "$d"/../.. 2>/dev/null)" x >/dev/null
    repo=$(cd "$d/../.." && basename "$PWD")
    for f in "$d"/*.md; do
      [ -e "$f" ] && printf '%s\t%s\n' "$(basename "$f" .md)" "$repo"
    done
  done
} | sort -u | while IFS=$'\t' read -r name scope; do
  printf '%-24s %-22s %s uses\n' "$name" "$scope" "$(echo "$commands" | grep -cx "$name" || true)"
done

echo
echo "=== SESSIONS LAUNCHED PER PROJECT (launch dir, not working dir) ==="
for d in "$PROJECTS"/*/; do
  c=$(find "$d" -maxdepth 1 -name '*.jsonl' -type f | grep -c . || true)
  [ "$c" -gt 0 ] && printf '%-52s %s\n' "$(basename "$d")" "$c"
done | sort -k2 -rn

echo
echo "=== ORPHANED AGENT NOTES (no matching agent definition) ==="
orphans=$(
  for d in "$HOME"/.claude/agents-memory/*/ "$REPOS"/*/agent-notes/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    find "$HOME/.claude/agents" "$REPOS" -name "$name.md" 2>/dev/null | grep -q . && continue
    printf '%-24s %s files  %s\n' "$name" "$(find "$d" -type f | grep -c . || true)" "$d"
  done
)
[ -n "$orphans" ] && echo "$orphans" || echo "(none)"

exit 0
