      "Bash(yarn build:*)"
    ],
    "defaultMode" : "auto",
    "deny" : [
      "Bash(sudo:*)",
      "Bash(dropdb:*)",
      "Bash(rm -rf \/:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -fr:*)",
      "Bash(git clean:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git restore:*)",
      "Bash(rails db:drop:*)",
      "Bash(rails db:reset:*)",
      "Bash(rails db:setup:*)",
      "Bash(rails db:schema:load:*)",
      "Bash(rails db:migrate:reset:*)",
      "Bash(bin\/rails db:drop:*)",
