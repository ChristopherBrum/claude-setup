{
  "$schema" : "https:\/\/json.schemastore.org\/claude-code-settings.json",
  "effortLevel" : "xhigh",
  "enabledPlugins" : {
    "figma@claude-plugins-official" : false,
    "i-have-adhd@i-have-adhd" : true,
    "ponytail@ponytail" : true
  },
  "extraKnownMarketplaces" : {
    "claude-code-plugins" : {
      "source" : {
        "repo" : "anthropics\/claude-code",
        "source" : "github"
      }
    },
    "i-have-adhd" : {
      "source" : {
        "repo" : "ayghri\/i-have-adhd",
        "source" : "github"
      }
    },
    "ponytail" : {
      "source" : {
        "repo" : "DietrichGebert\/ponytail",
        "source" : "github"
      }
    }
  },
  "feedbackSurveyState" : {
    "lastShownTime" : 1754088909800
  },
  "hooks" : {
    "Notification" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/christopher\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/christopher\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/sync-howto-reminder.sh",
            "statusMessage" : "Checking whether HOW-TO.md needs a sync...",
            "type" : "command"
          }
        ],
        "matcher" : "Write|Edit"
      },
      {
        "hooks" : [
          {
            "command" : "\/Users\/christopher\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/block-destructive-commands.sh",
            "statusMessage" : "Checking for destructive commands...",
            "type" : "command"
          },
          {
            "command" : "~\/.claude\/hooks\/block-git-history-rewrite.sh",
            "if" : "Bash(git *)",
            "statusMessage" : "Checking for history-rewriting git commands...",
            "type" : "command"
          },
          {
            "command" : "~\/.claude\/hooks\/restrict-subagent-bash.sh",
            "statusMessage" : "Checking subagent shell restrictions...",
            "type" : "command"
          }
        ],
        "matcher" : "Bash"
      },
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/block-sensitive-writes.sh",
            "statusMessage" : "Checking for sensitive-path access...",
            "type" : "command"
          }
        ],
        "matcher" : "Read|Edit|Write|MultiEdit"
      },
      {
        "hooks" : [
          {
            "command" : "ruby ~\/.claude\/hooks\/agent_clone_boundary.rb",
            "statusMessage" : "Checking checkout boundary...",
            "type" : "command"
          }
        ],
        "matcher" : "Write|Edit|MultiEdit|Bash"
      },
      {
        "hooks" : [
          {
            "command" : "\/Users\/christopher\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/christopher\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/christopher\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/length-budget.sh --measure",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "\/Users\/christopher\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "StopFailure" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/christopher\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SubagentStop" : [
      {
        "hooks" : [
          {
            "command" : "\/Users\/christopher\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/length-budget.sh --remind",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "\/Users\/christopher\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ]
  },
  "model" : "opus[1m]",
  "permissions" : {
