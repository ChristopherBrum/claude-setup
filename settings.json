      "Bash(~\/.claude\/bin\/pr-diff-lines:*)",
      "Bash(~\/.claude\/bin\/claude-usage:*)",
      "Bash(~\/.claude\/bin\/claude-prompts:*)",
      "Bash(~\/.claude\/bin\/link-personal-claude:*)",
      "Bash(~\/.claude\/bin\/bootstrap:*)",
      "Bash(gh run list:*)",
